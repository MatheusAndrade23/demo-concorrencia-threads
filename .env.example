# Conexão com o Postgres do docker-compose.yml
PGHOST=localhost
PGPORT=5433
PGUSER=demo
PGPASSWORD=demo
PGDATABASE=banco

# Estado inicial do banco. O total esperado é sempre CONTAS * SALDO_INICIAL,
# e essa é a invariante que todo cenário verifica no fim.
CONTAS=10
SALDO_INICIAL=1000

# Padrões dos cenários quando rodados sozinhos
OPERACOES=200
CONCORRENCIA=32
VALOR_SAQUE=1
