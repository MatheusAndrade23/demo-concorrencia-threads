# Conexao com o Postgres do docker-compose.yml
PGHOST=localhost
PGPORT=5433
PGUSER=demo
PGPASSWORD=demo
PGDATABASE=banco

# Estado inicial do banco. O total esperado e sempre CONTAS * SALDO_INICIAL,
# e essa e a invariante que todo cenario verifica no fim.
CONTAS=10
SALDO_INICIAL=1000

# Padroes dos cenarios quando rodados sozinhos
OPERACOES=200
CONCORRENCIA=32
VALOR_SAQUE=1
