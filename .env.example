# Conexão com o Postgres do docker-compose.yml
PGHOST=localhost
PGPORT=5433
PGUSER=demo
PGPASSWORD=demo
PGDATABASE=banco

# Estado inicial do banco. O total esperado é sempre CONTAS * SALDO_INICIAL,
# e essa é a invariante que todo caso verifica no fim. O caso 05 semeia contas a
# mais quando precisa, porque cada thread dele exige um par exclusivo.
CONTAS=10
SALDO_INICIAL=1000

# Carga padrão por repetição, dividida entre as threads. O número de threads não
# vem daqui: é derivado de os.availableParallelism(), ver src/ambiente.ts.
OPERACOES=200
VALOR_SAQUE=1
