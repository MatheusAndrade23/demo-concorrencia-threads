{
  "name": "demo-concorrencia-threads",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Projeto didático: bugs de concorrência com worker_threads, medidos e comparados por número de threads",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "tsx src/db.ts --reset",
    "bench": "tsx src/benchmark.ts",
    "charts": "tsx src/charts.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vega": "^6.4.0",
    "vega-cli": "^6.4.0",
    "vega-lite": "^6.4.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
